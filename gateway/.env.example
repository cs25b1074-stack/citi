# Gateway environment variables
# Copy to .env and fill in real values before `npm run dev`

PORT=4000
CHANNEL=pulsechannel
CHAINCODE=pulse

# Path to the directory produced by network/collect-identities.sh
CRYPTO_PATH=../network/out/organizations

# SQLite database path (created automatically)
DB_PATH=./data/pulse.db

# Org1 (Bank A – remitter)
ORG1_PEER_ENDPOINT=localhost:7051
ORG1_PEER_HOST_ALIAS=peer0.org1.example.com

# Org2 (Bank B – beneficiary)
ORG2_PEER_ENDPOINT=localhost:9051
ORG2_PEER_HOST_ALIAS=peer0.org2.example.com

# Org3 (Regulator – read-only listener)
ORG3_PEER_ENDPOINT=localhost:11051
ORG3_PEER_HOST_ALIAS=peer0.org3.example.com
